rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Jeder Nutzer liest und schreibt nur sein eigenes Dokument.
    // Admins (UID in der Sammlung "admins") dürfen alle Nutzer lesen.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.username is string
                    && request.resource.data.username.size() <= 20;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Admin-Liste: Jeder darf nur prüfen, ob er selbst Admin ist.
    // Einträge legst du nur in der Firebase-Konsole an.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
